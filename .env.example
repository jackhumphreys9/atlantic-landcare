# Copy this file to .env.local for local development.
# .env.local is gitignored — never commit real keys.
#
# On Vercel, set these same values under Project → Settings → Environment Variables.

# From https://resend.com/api-keys (free tier: 3,000 emails/month).
# If this is unset in development the contact form still works — submissions
# are logged to the terminal instead of emailed.
RESEND_API_KEY=

# Where contact form submissions are delivered. Overrides site.contactInbox.
CONTACT_TO_EMAIL=

# The "from" address. Until you verify a domain in Resend, leave this unset and
# it falls back to onboarding@resend.dev, which only delivers to the email you
# signed up with. Once your domain is verified, use something like:
#   CONTACT_FROM_EMAIL=website@yourdomain.com
CONTACT_FROM_EMAIL=
